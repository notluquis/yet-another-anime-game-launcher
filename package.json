{
  "name": "yaagl",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "start": "YAAGL_CHANNEL_CLIENT=hk4eos vite build --mode=\"development\" && cp './neutralino.js' './dist/neutralino.js' && mkdir -p yaaglwdos && cp neutralino.config.json yaaglwdos/neutralino.config.json && rsync -rlptu dist yaaglwdos && rsync -rlptu sophon_server/dist/sophon-server sidecar/sophon_server/ && rsync -rlptu sidecar yaaglwdos && rsync -rlptu src/icons yaaglwdos/src && neu run -- --path=./yaaglwdos",
    "dev": "vite",
    "build": "YAAGL_CHANNEL_CLIENT=hk4eos vite build",
    "build-dev": "vite build --mode=\"development\"",
    "lint": "eslint ./src --ext .ts --ext .tsx",
    "format": "prettier -w ./src",
    "format-check": "prettier -c ./src",
    "precommit": "tsc && pnpm run lint && pnpm run format-check"
  },
  "license": "MIT",
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "libaria2-ts": "^1.0.91",
    "path-browserify": "^1.0.1",
